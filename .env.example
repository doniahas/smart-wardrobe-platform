# Smart Wardrobe - example environment configuration.
# Copy to `.env` and fill in the required secrets. `.env` is gitignored;
# never commit real credentials.

# --- MongoDB ---------------------------------------------------------------
# Default (unauthenticated) shape - only used directly if running web
# outside docker-compose against a local, auth-free mongod. Under
# docker-compose, MONGO_URI is overridden with the authenticated form
# assembled from MONGO_ROOT_USERNAME/MONGO_ROOT_PASSWORD below.
MONGO_URI=mongodb://mongo:27017
# Required: MongoDB root credentials - docker-compose.yml assembles the
# real, authenticated MONGO_URI from these two at container start. Use
# plain letters and numbers (no URI-special characters such as : @ /).
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
DATABASE_NAME=smartwardrobe
# Graceful MongoDB-outage handling: bounds how long a request can hang
# selecting a Mongo server before the app treats it as unreachable and
# returns a clean 503 (see app/core/error_handlers.py) - PyMongo/Motor's
# own default is 30000 (30s), far too slow for a prompt, controlled
# failure response. Optional - a sensible default applies.
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Internal service URLs ---------------------------------------------------
RECOMMENDATION_SERVICE_URL=http://recommendation:8001
LLM_SERVICE_URL=http://llm:8002
LLM_SERVICE_TIMEOUT_SECONDS=65.0
# Catalog (crawler) service - real/mock crawled clothing products.
CATALOG_SERVICE_URL=http://catalog:8003
CATALOG_SERVICE_TIMEOUT_SECONDS=30.0
# Shared Redis instance backing web's rate-limit counters
# (services/web/app/core/limiter.py) and cross-replica WebSocket
# live-notification Pub/Sub (services/web/app/services/redis_client.py), so
# multiple web replicas share one rate-limit counter per client key and
# deliver live events to sockets on any replica. Safe default if unset.
REDIS_URL=redis://redis:6379/0

# --- Catalog -----------------------------------------------------------------
CATALOG_ENABLED=true
CATALOG_SUGGESTIONS_MAX_RESULTS=10
# catalog service's own tuning (services/catalog/app/core/config.py) - safe
# defaults if left unset.
CATALOG_MAX_CONCURRENCY=5
CATALOG_MAX_ATTEMPTS=3
CATALOG_RETRY_BASE_DELAY_SECONDS=0.5
CATALOG_REQUEST_TIMEOUT_SECONDS=10.0

# --- Local LLM (Ollama) ------------------------------------------------------
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=moondream:latest
OLLAMA_GENERATE_TIMEOUT_SECONDS=60.0
OLLAMA_KEEP_ALIVE=30m

# --- Chat job queue ----------------------------------------------------------
CHAT_WORKER_CONCURRENCY=2
CHAT_WORKER_POLL_INTERVAL_SECONDS=0.5
CHAT_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30.0
# Stale "processing" chat job recovery (see
# services/chat_queue.py::reclaim_stale_jobs). Default is 2x
# LLM_SERVICE_TIMEOUT_SECONDS - raise this if LLM_SERVICE_TIMEOUT_SECONDS is
# raised, so a merely-slow (not abandoned) job is never reclaimed early.
# ENFORCED, not just documented: app startup (services/web/app/core/
# config.py::validate_chat_job_stale_timeout) raises and refuses to start if
# this is set below 1.5x LLM_SERVICE_TIMEOUT_SECONDS - a stale timeout too
# close to (or under) the LLM timeout can reclaim a job that's still
# genuinely processing.
CHAT_JOB_STALE_TIMEOUT_SECONDS=130.0
CHAT_JOB_MAX_ATTEMPTS=3
CHAT_JOB_RECOVERY_INTERVAL_SECONDS=30.0

# --- Auth --------------------------------------------------------------------
# Required: generate a real secret, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# The app refuses to start without one (outside TESTING mode).
JWT_SECRET=
TESTING=false

# --- Rate limits (slowapi syntax: "<count>/<period>") ------------------------
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_RECOMMENDATION=20/minute
RATE_LIMIT_CATALOG=20/minute
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_WARDROBE_WRITE=30/minute
RATE_LIMIT_FEEDBACK=30/minute
RATE_LIMIT_OUTFIT_WRITE=30/minute
RATE_LIMIT_MEMORY_WRITE=30/minute
RATE_LIMIT_POST_WRITE=30/minute
RATE_LIMIT_REACTION_WRITE=30/minute
RATE_LIMIT_COMMENT_WRITE=30/minute
RATE_LIMIT_MESSAGE_WRITE=30/minute

# --- Uploads & media ---------------------------------------------------------
# Wardrobe image signed-URL lifetime (seconds) - see services/image_storage.py.
WARDROBE_IMAGE_URL_TTL_SECONDS=3600
UPLOAD_DIR=/app/uploads/wardrobe
MAX_UPLOAD_SIZE_MB=5
EXPLORE_UPLOAD_DIR=/app/uploads/explore
MAX_EXPLORE_IMAGE_SIZE_MB=5
# MP4 video attachments on posts/comments - separate, larger cap than
# images. 20MB comfortably fits a short clip while keeping the worst case
# for one request (MAX_EXPLORE_ATTACHMENTS videos) bounded.
MAX_EXPLORE_VIDEO_SIZE_MB=20
MAX_EXPLORE_ATTACHMENTS=4
DM_UPLOAD_DIR=/app/uploads/dm
MAX_DM_IMAGE_SIZE_MB=5
MAX_DM_VIDEO_SIZE_MB=20
MAX_DM_ATTACHMENTS=4

# --- WebSocket ---------------------------------------------------------------
WS_AUTH_TIMEOUT_SECONDS=5
MAX_WS_CONNECTIONS_PER_USER=3

# --- Demo data ---------------------------------------------------------------
# Cold-seed: controls the one-shot `seed` service in docker-compose.yml,
# which runs scripts/seed_demo_data.py against the real `web` API on every
# `docker compose up -d` (idempotent - safe to re-run, never duplicates or
# touches real user data). Defaults to true here (local/dev);
# docker-compose.prod.yml hard-overrides this to false for production
# regardless of this file's value - see that file's own comment.
SEED_DEMO_DATA=true

# Optional, production-only credential for scripts/seed_demo_data.py
# --profile production (a separate, realistic-looking synthetic dataset for
# a real deployment - see docs/deployment.md's "Production cold-seed"
# section). Left empty here on purpose - never set a real value in this
# checked-in example file. A real deployment provisions this the same way
# it provisions JWT_SECRET/MONGO_ROOT_PASSWORD: only in the production
# host's own out-of-band .env, never committed to git. Not read by
# SEED_DEMO_DATA/the `seed` compose service at all - the production
# profile is never run automatically, only manually via --profile
# production.
PROD_SEED_PASSWORD=

# --- Production reverse proxy (Caddy) ----------------------------------------
# Production only - read by Caddyfile via docker-compose.prod.yml's caddy
# service. Not used by local `docker compose up` (no caddy service there)
# or by any application code. Must be a real, publicly resolvable domain
# name pointing at the host for Caddy's automatic HTTPS to work - see
# docs/deployment.md. Set to "localhost" only for local reverse-proxy
# testing with Caddy's internal CA, never for a real deployment.
DOMAIN=
